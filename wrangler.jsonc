{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lunaria",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-21",
  "containers": [
    {
      "class_name": "RpgContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RPG_CONTAINER",
        "class_name": "RpgContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RpgContainer"]
    }
  ]
}
