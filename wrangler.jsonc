{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lunaria",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RPG_CONTAINER",
        "class_name": "RpgContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RpgContainer"]
    }
  ]
}
